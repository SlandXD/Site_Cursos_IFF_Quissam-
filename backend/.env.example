# ── Construct Academy — Variáveis de Ambiente ──────────────────────────────
# Copie este arquivo para .env e preencha os valores antes de iniciar o servidor.
# Nunca faça commit do arquivo .env com valores reais.

# Segredo usado para assinar tokens JWT.
# Gere um valor seguro com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=TROQUE_POR_UM_SEGREDO_FORTE_AQUI

# Porta em que o servidor vai rodar (padrão: 3000)
PORT=3000

# Ambiente: development | production
NODE_ENV=development
